{
  "name": "flyvpn",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:endpoints": "esbuild test/vpnEndpointService.test.ts --bundle --platform=node --format=esm --outfile=.cache/vpnEndpointService.test.cjs --external:react --external:react-dom --external:leaflet --external:react-leaflet && node .cache/vpnEndpointService.test.cjs",
    "test:services": "esbuild test/services.test.ts --bundle --platform=node --format=esm --outfile=.cache/services.test.cjs --external:react --external:react-dom --external:leaflet --external:react-leaflet && node .cache/services.test.cjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "2.12.0",
    "@google/genai": "1.34.0",
    "leaflet": "1.9.4",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
